# FC도착 — 환경변수 이름만. 값은 .env.local(커밋 안 함) 또는 Vercel 프로젝트 설정에만 넣습니다.
# 비워 두면 PGlite(프로세스 안 Postgres)로 끝까지 돕니다.

# DB — 새 Supabase 프로젝트의 연결 문자열(Transaction pooler 권장)
DATABASE_URL=
DATABASE_POOL_MAX=

# Supabase Auth · Storage(비공개 버킷 fcd-docs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 세션 서명(32자 이상 임의 문자열) — 배포에서는 꼭 넣습니다
SESSION_SECRET=

# 공개 주소(메타·OG·사이트맵)
NEXT_PUBLIC_SITE_URL=

# 데모 — on/off. 끄면 운영 화면 밖에서 예시가 사라집니다(docs/DEMO.md)
DEMO_MODE=
DEMO_PASSWORD=

# 밖으로 나가는 것(메일·문자·카톡·외부 API 쓰기). 기본 꺼짐
OUTBOUND_ENABLED=

# 로컬 PGlite
PGLITE_DIR=
PGLITE_SEED_DEMO=

# 첫 운영자(npm run admin:create 때만)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# 시험용 고정 오늘(YYYY-MM-DD)
FCD_TODAY=

# 버전 비교실(/lab) 끼워 보기 — 공개 비교용 판 프로젝트에만(docs/DEPLOY.md)
FRAME_ANCESTORS=
EMBED_COOKIES=
NEXT_PUBLIC_LAB_ORIGIN=
LAB_VERSIONS=
